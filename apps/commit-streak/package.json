{
  "name": "commit-streak",
  "version": "0.1.0",
  "description": "Menu bar app that reads your local git commits and reminds you to commit before the day ends.",
  "private": true,
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "make-app-icon": "node scripts/make-app-icon.js",
    "dist": "npm run make-app-icon && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.guimuller.commit-streak",
    "productName": "Commit Streak",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": 1
      }
    },
    "dmg": {
      "title": "Commit Streak"
    }
  }
}
