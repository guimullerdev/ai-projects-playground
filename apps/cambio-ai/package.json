{
  "name": "cambio-ai",
  "private": true,
  "version": "0.1.0",
  "description": "macOS menu-bar app with the live USD/BRL rate and its intraday/30-day trajectory",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "make-icon": "node scripts/make-icon.js",
    "make-app-icon": "node scripts/make-app-icon.js",
    "dist": "npm run make-app-icon && electron-builder --mac"
  },
  "dependencies": {
    "menubar": "^9.5.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.guimuller.cambio-ai",
    "productName": "Cambio AI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": 1
      }
    },
    "dmg": {
      "title": "Câmbio AI"
    }
  }
}
